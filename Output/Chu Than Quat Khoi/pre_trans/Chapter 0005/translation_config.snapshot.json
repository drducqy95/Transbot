      "western_latin": {
        "preserve_original": true,
        "translate_titles_only": true,
        "examples": [
          {
            "source": "Harry Potter",
            "correct": "Harry Potter",
            "wrong": "Cáp Lợi Ba Đặc",
            "context": "tên người phương Tây/fandom"
          },
          {
            "source": "Arthur",
