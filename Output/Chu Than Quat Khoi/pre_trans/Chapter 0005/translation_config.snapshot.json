          }
        ]
      },
      "world_concept": {
        "enabled": true,
        "description": "Khái niệm riêng của thế giới truyện, luật lệ, chủng tộc, thế lực, hệ thống sức mạnh.",
        "translation_style": "ưu tiên nhất quán theo worldbuilding, không dịch lẫn với nghĩa phổ thông",
        "examples": [
          {
            "source": "灵气",
            "wrong": "khí linh",
            "correct": "linh khí",
            "context": "năng lượng tu luyện"
          },
          {
            "source": "魔力",
            "wrong": "sức ma nếu không hợp văn cảnh",
            "correct": "ma lực",
            "context": "fantasy/magic"
          },
          {
            "source": "斗气",
            "wrong": "khí đánh nhau",
            "correct": "đấu khí",
            "context": "huyền huyễn"
          }
        ]
      }
    },
    "context_detection": {
      "enabled": true,
      "detect_by": [
        "nearby_verbs",
        "nearby_nouns",
        "speaker_identity",
        "genre_profile",
        "world_setting",
        "chapter_context",
        "previous_confirmed_usage",
        "sentence_role",
        "punctuation_and_format",
        "appears_in_status_panel",
        "appears_in_combat_scene",
        "appears_in_profession_intro",
        "appears_in_dialogue_title_calling"
      ],
      "rules": {
        "if_term_appears_after_cast_use_activate_perform": "likely_skill_move",
        "if_term_appears_after_profession_rank_number": "likely_profession_or_rank",
        "if_term_appears_in_status_panel": "likely_system_game_term",
        "if_term_appears_with_sect_clan_rank": "likely_title_position",
        "if_term_appears_with_equip_take_out_refine_swallow": "likely_item_artifact",
        "if_term_appears_as_addressing_to_person": "likely_title_or_position",
        "if_term_appears_as_world_power_system": "likely_world_concept"
      }
    },
    "translation_decision_rules": [
      "Không dịch thuật ngữ chỉ theo mặt chữ.",
      "Một source có thể có nhiều bản dịch nếu văn cảnh khác nhau.",
      "Một bản dịch đã khóa chỉ áp dụng cho đúng loại văn cảnh đã khóa.",
      "Tên chiêu thức, cảnh giới, pháp bảo quan trọng nên dùng dạng Hán Việt chuẩn, viết hoa nếu là danh từ riêng.",
      "Vật phẩm phổ thông không cần Hán Việt hóa quá mức.",
      "Nghề nghiệp phải xét bối cảnh.",
      "Chức vị phải xét hệ thống xã hội.",
      "Nếu cùng source và cùng văn cảnh, phải giữ nhất quán.",
      "Nếu không chắc văn cảnh, đánh dấu audit."
    ],
    "normalization_fields": {
      "source": "原文术语",
      "primary_translation": "bản dịch chính",
      "contextual_translations": [
        {
          "translation": "bản dịch theo văn cảnh",
          "context": "văn cảnh áp dụng",
          "term_type": "loại thuật ngữ",
          "example_sentence": "câu ví dụ",
          "locked": false
        }
      ],
      "term_type": "skill_move/profession/rank_realm/title_position/item_artifact/system_game_term/world_concept/etc",
      "domain": "xianxia/wuxia/game/modern/fantasy/historical/fanfiction/etc",
      "register": "cổ phong/hiện đại/game/chuyên môn/đời thường",
      "first_seen_chapter": "chương xuất hiện đầu tiên",
      "usage_note": "ghi chú cách dùng",
      "forbidden_translations": [
        "các bản dịch sai cần tránh"
      ],
      "locked": false
    },
    "conflict_policy": {
      "manual_term_lock_wins": true,
      "locked_term_requires_context_match": true,
      "contextual_translation_wins_over_flat_dictionary": true,
      "story_glossary_wins_over_vietphrase": true,
      "profession_context_wins_over_common_dictionary": true,
      "skill_context_wins_over_literal_translation": true,
      "item_name_context_wins_over_common_noun_translation": true,
      "same_source_different_context_allow_different_translation": true,
      "same_source_same_context_must_be_consistent": true,
      "if_context_uncertain_mark_for_audit": true
    }
  },
  "proper_name_normalization": {
    "enabled": true,
    "purpose": "Chuẩn hóa tên riêng theo nguồn gốc ngôn ngữ và bản dịch chuẩn đã phổ biến, tránh Hán Việt hóa sai tên phương Tây, Nhật, Hàn, fandom, thương hiệu, thuật ngữ kỹ thuật.",
    "core_principle": {
      "canonical_name_first": true,
      "do_not_hanvietize_non_chinese_names": true,
      "preserve_globally_known_names": true,
      "preserve_brand_and_technical_names": true,
      "use_fandom_standard_translation_if_available": true,
      "source_plus_origin_plus_context_plus_canonical_standard_equals_translation": true,
      "context_first": true
    },
    "priority_order": [
      "manual_name_lock",
      "fandom_canonical_glossary",
      "official_translation",
      "widely_used_vietnamese_translation",
      "original_latin_spelling",
      "romaji_or_revised_romanization",
      "han_viet_only_for_chinese_context",
      "contextual_detection"
    ],
    "name_origin_detection": {
      "enabled": true,
      "detect_types": [
        "chinese",
        "japanese",
        "korean",
        "western_latin",
        "brand",
        "technical_term",
        "fandom_character",
        "game_character",
        "place",
        "organization",
        "mixed_origin"
      ],
      "rules": {
        "if_latin_script": "preserve_original_spelling_unless_official_vietnamese_name_exists",
        "if_known_japanese_fandom": "use_romaji_or_fandom_standard_name",
        "if_known_korean_name": "use_common_korean_vietnamese_or_revised_romanization",
        "if_known_western_name": "preserve_original_latin_name",
        "if_brand_or_technology": "preserve_standard_name",
        "if_chinese_context_and_chinese_characters": "use_han_viet_or_locked_story_name",
        "if_mixed_fandom_context": "check_fandom_canonical_glossary_before_dictionary"
      }
    },
    "origin_specific_policy": {
      "chinese": {
        "prefer_han_viet_when_context_is_chinese": true,
        "examples": [
          {
            "source": "陆沉",
